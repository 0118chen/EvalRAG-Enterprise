APP_ENV=development
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evalrag-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
RAG_VERSION=v0.1.0
PROMPT_VERSION=policy_qa_v1
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=evalrag_chunks
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=evalrag_chunks
DENSE_RETRIEVAL_BACKEND=local
SPARSE_RETRIEVAL_BACKEND=local
EXTERNAL_RETRIEVAL_FALLBACK=true
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=32
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///data/evalrag.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTH_ENABLED=false
API_KEYS={}
# 用长期 API Key 换短期会话令牌（POST /api/v1/auth/session）：浏览器只拿 token，
# 密钥不落任何 storage，token 有 TTL、可吊销、可审计。
# TTL 是凭据最长寿命；TOUCH 是 last_used_at 的写入间隔（越小审计越准、写越多）。
SESSION_TTL_SECONDS=3600
SESSION_TOUCH_SECONDS=60
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=120
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
# lexical (默认，本地确定性) | typesafe（语义重排，需要 key 且会把候选文本发到第三方）
RERANK_BACKEND=lexical
# 只有 RERANK_BACKEND=typesafe 时才读；计费按输入 token（$42/Btok，输出免费），
# key 从 https://console.typesafe.ai/keys 取。别把它设成常驻默认值：测试与离线 harness
# 会读同一份 .env，届时每次检索都会真的去调付费接口。
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_CONCURRENCY=8
RETRIEVAL_CANDIDATE_MULTIPLIER=4
# 引用里出现未检索到的文档或页码时，回答一律被拒（这不是开关）。下面的开关只控制
# "完全不带引用的回答"是否也算拒绝：mock 与部分本地模型本来就不写引用，所以默认关闭。
CITATION_REQUIRED=false
EVALUATION_INLINE_FALLBACK=false
# 评测一次几十到几百题，每题可能打付费 embedding/rerank 与两次 LLM 调用：有界并发把
# 小时级压到分钟级。这个上限是 per-example 的，Typesafe 重排另有 TYPESAFE_CONCURRENCY。
EVALUATION_CONCURRENCY=4
# 每道题的超时（秒）。一个卡死的后端调用不该拖住整轮评测：超时的题记为 error 并按
# 0 条指标计入 timed_out_example_count，不参与任何均值。每个完成的题都会 checkpoint，
# 所以 Celery 重试同一个 evaluation_id 时只补跑剩下的题。
EVALUATION_EXAMPLE_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=50
# 上传落到对象存储，API 与 worker 不再共享本地卷（两者因此可以分开部署，下载也由
# 预签名 URL 直接回答）。默认 local = 就是 data/uploads，行为与单机开发一致；
# docker compose up 会把 OBJECT_STORE 覆盖成 s3 并起一个 MinIO。
OBJECT_STORE=local
OBJECT_STORE_LOCAL_DIR=data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=evalrag
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
# 预签名 URL 由浏览器打开，所以里面的主机名必须是浏览器能解析的。compose 里 API 走
# http://minio:9000，而浏览器不在那个网络里，因此在 compose 中把它设成 localhost:9000。
S3_PUBLIC_ENDPOINT_URL=
S3_PRESIGN_SECONDS=300
# /health/llm and /health/langsmith call paid providers. APP_ENV=development is
# exempted automatically; any other environment needs the X-Health-Token header.
HEALTH_CHECKS_PUBLIC=false
HEALTH_ADMIN_TOKEN=
