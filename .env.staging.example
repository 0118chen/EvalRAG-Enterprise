APP_ENV=staging
POSTGRES_PASSWORD=
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=evalrag-staging
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
RAG_VERSION=staging
PROMPT_VERSION=policy_qa_v1
CORS_ORIGINS=["http://localhost:8080"]
AUTH_ENABLED=true
API_KEYS={"replace-with-a-long-random-key":"staging-tenant"}
# 会话令牌 TTL（秒）与 last_used_at 写入间隔（秒）。
SESSION_TTL_SECONDS=3600
SESSION_TOUCH_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=redis
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=120
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
RETRIEVAL_CANDIDATE_MULTIPLIER=4
EVALUATION_INLINE_FALLBACK=false
MAX_UPLOAD_MB=50
# Same object-store shape as production: the compose file starts MinIO, creates the bucket and
# requires both credentials plus the hostname the browser uses to reach it.
OBJECT_STORE=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=evalrag
S3_REGION=us-east-1
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_PATH_STYLE=true
S3_PRESIGN_SECONDS=300
# /health/llm and /health/langsmith call paid providers. Staging is not a local
# environment, so they require this header: curl -H "X-Health-Token: $HEALTH_ADMIN_TOKEN".
# Leave empty only if you want those checks to fail closed with 503.
HEALTH_CHECKS_PUBLIC=false
HEALTH_ADMIN_TOKEN=replace-with-a-random-token
