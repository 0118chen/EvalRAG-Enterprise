APP_ENV=production
POSTGRES_PASSWORD=
LANGSMITH_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evalrag-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
RAG_VERSION=v1.0.0
PROMPT_VERSION=policy_qa_v1
# Production Compose does not start Milvus/Elasticsearch; use reachable external services.
DENSE_RETRIEVAL_BACKEND=milvus
SPARSE_RETRIEVAL_BACKEND=elasticsearch
EXTERNAL_RETRIEVAL_FALLBACK=false
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
MILVUS_URI=https://milvus.example.com:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=evalrag_chunks
ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=evalrag_chunks
CORS_ORIGINS=["https://evalrag.example.com"]
AUTH_ENABLED=true
API_KEYS={"replace-with-a-long-random-key":"production-tenant"}
# 会话令牌：浏览器只持有短期 token（POST /api/v1/auth/session 换取），TTL 到期自动失效。
SESSION_TTL_SECONDS=3600
SESSION_TOUCH_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=redis
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=300
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
RETRIEVAL_CANDIDATE_MULTIPLIER=4
# A citation naming a document or page that was not retrieved is always refused. Setting
# this to true additionally refuses answers that cite nothing at all - the right policy for
# compliance work, but only once you have confirmed your model actually emits citations in
# the `[<document_id> p.<page>]` form the prompt shows it.
CITATION_REQUIRED=false
EVALUATION_INLINE_FALLBACK=false
# Bounded per-example concurrency for evaluation runs: one question can cost a paid
# embedding, a paid rerank and two LLM calls, so a 75-question set is minutes not hours.
# Raise it only as far as your provider's rate limits allow.
EVALUATION_CONCURRENCY=4
# Per-question timeout in seconds. A hung backend call is recorded as a timed-out example
# (excluded from every average, counted in timed_out_example_count) instead of holding the
# whole run. Completed questions are checkpointed, so a Celery retry of the same
# evaluation_id only pays for the questions that are still missing.
EVALUATION_EXAMPLE_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=50
# Uploads live in an object store instead of a volume mounted by both api and worker, so the
# two can run on separate hosts and a download is answered with a URL rather than a streamed
# file. The compose file starts MinIO and creates the bucket; point these at any S3-compatible
# service instead and drop that service.
OBJECT_STORE=s3
S3_ENDPOINT_URL=http://minio:9000
# A presigned URL is opened by the browser, so it must name a host the browser can reach.
# Inside the compose network the store is `minio`; the browser is not on that network, so this
# has to be the public hostname. The compose file refuses to start without it.
S3_PUBLIC_ENDPOINT_URL=https://objects.evalrag.example.com
S3_BUCKET=evalrag
S3_REGION=us-east-1
# Credentials for the object store. The compose file reads S3_ACCESS_KEY/S3_SECRET_KEY from
# these two, and requires both to be set.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# MinIO needs path-style addressing; most managed S3 services want virtual-host style.
S3_PATH_STYLE=true
# Lifetime of a download URL, in seconds.
S3_PRESIGN_SECONDS=300
# /health/llm and /health/langsmith call paid providers. Production is not a local
# environment, so they require this header: curl -H "X-Health-Token: $HEALTH_ADMIN_TOKEN".
HEALTH_CHECKS_PUBLIC=false
HEALTH_ADMIN_TOKEN=replace-with-a-random-token
