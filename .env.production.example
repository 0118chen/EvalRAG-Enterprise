APP_ENV=production
POSTGRES_PASSWORD=
LANGSMITH_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evalrag-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
RAG_VERSION=v1.0.0
PROMPT_VERSION=policy_qa_v1
# Production Compose does not start Milvus/Elasticsearch; use reachable external services.
DENSE_RETRIEVAL_BACKEND=milvus
SPARSE_RETRIEVAL_BACKEND=elasticsearch
EXTERNAL_RETRIEVAL_FALLBACK=false
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
MILVUS_URI=https://milvus.example.com:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=evalrag_chunks
ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=evalrag_chunks
CORS_ORIGINS=["https://evalrag.example.com"]
AUTH_ENABLED=true
API_KEYS={"replace-with-a-long-random-key":"production-tenant"}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=redis
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=300
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
RETRIEVAL_CANDIDATE_MULTIPLIER=4
EVALUATION_INLINE_FALLBACK=false
MAX_UPLOAD_MB=50
